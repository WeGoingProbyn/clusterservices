# /etc/clusterservices/agent.env — read by cs-agent.service.
#
# Written by whatever provisions this node. That is the point: an agent that
# worked out its own topology would need Slurm credentials and a reason to be
# trusted with them.

# The head to dial. One endpoint for now; an ordered list with failover is a
# design note in CLAUDE.md and needs a policy, not just a comma.
CS_SERVER=tcp://head01:7777

# What *Slurm* calls this node, which is not always its hostname — and the
# hostname is all the agent can work out for itself.
#CS_NODE=node-7

# Anything else is a flag on ExecStart: --interval, --window, --cgroups.
# On a real Slurm node you want:
#   ExecStart=/usr/bin/cs-agent --no-burn --cgroups
