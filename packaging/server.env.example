# /etc/clusterservices/server.env — read by cs-server.service.

# Where agents connect.
CS_LISTEN=tcp://0.0.0.0:7777

# Where operators running cs-ctl connect. Loopback on purpose: nothing in this
# protocol authenticates anybody yet, so this address is the only lock on a
# fleet-wide restart. Reach it over ssh, or move it to a management interface you
# trust — not to 0.0.0.0.
CS_ADMIN=tcp://127.0.0.1:7788

# This head's name, used in logs and in the Goodbye it sends agents.
#CS_NODE=head01
